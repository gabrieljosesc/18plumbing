# Supabase — project "18plumbing"
#
# PLACEHOLDERS ONLY. Copy this to .env.local (git-ignored) and paste the real
# values from Supabase → Project Settings → API. Do not put live values here:
# anyone who copies this file straight across would point their local dev at
# the production database and write test signups into real member data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx

# The origin the site is served from — drives the canonical URL, Open Graph
# tags, sitemap and structured data. Leave it unset on Vercel and the
# deployment's own domain is used automatically. It is set in production
# because the site answers on both the apex and www: without pinning one,
# canonical tags can disagree with the domain Google Ads and GA4 are keyed to.
# NEXT_PUBLIC_SITE_URL=https://www.18plumbing.ca

# Conversion tracking. Every one of these is optional — with none of them set
# no third-party script is loaded at all, and track() quietly does nothing.
#
# The three AW- labels come from Google Ads → Goals → Conversions → the action
# → Tag setup, and are the part of send_to AFTER the slash. They are per-action
# on purpose: two events sharing a label merge in reporting, and if that action
# drives bidding, the cheaper event inflates the expensive one.
#
# None of these are secrets — they ship in the page source by design.
# NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXXX
# NEXT_PUBLIC_ADS_CALL_LABEL=
# NEXT_PUBLIC_ADS_TEXT_LABEL=
# NEXT_PUBLIC_ADS_LEAD_LABEL=

# Both member tables are protected by RLS scoped to auth.uid(), so the
# publishable key above is all the app needs. There is no service-role key in
# this project — if you ever add one for admin tooling, keep it server-side and
# never prefix it with NEXT_PUBLIC_.
