# Supabase — project "18plumbing"
#
# PLACEHOLDERS ONLY. Copy this to .env.local (git-ignored) and paste the real
# values from Supabase → Project Settings → API. Do not put live values here:
# anyone who copies this file straight across would point their local dev at
# the production database and write test signups into real member data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx

# Both member tables are protected by RLS scoped to auth.uid(), so the
# publishable key above is all the app needs. There is no service-role key in
# this project — if you ever add one for admin tooling, keep it server-side and
# never prefix it with NEXT_PUBLIC_.
